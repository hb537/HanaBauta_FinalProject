model_unaj <- lm(anx_score ~ internet_1, data = analysis_df)
tidy(model_unaj, conf.int = TRUE) %>%
mutate(
term = recode(term, "(Intercept)" = "Intercept",
"internet_1"  = "Internet Hours/Day"),
across(where(is.numeric), ~round(.x, 3))
) %>%
rename(Term = term, `β` = estimate, SE = std.error,
`t` = statistic, `p-value` = p.value,
`95% CI Low` = conf.low, `95% CI High` = conf.high) %>%
kable(booktabs = TRUE,
caption = "Model 1: Unadjusted linear regression of GAD-7 anxiety score on daily internet hours (N = 34,953).") %>%
kable_styling(latex_options = c("striped", "hold_position"), font_size = 9) %>%
row_spec(0, bold = TRUE)
tidy(model_adj, conf.int = TRUE) %>%
mutate(
term = recode(term,
"(Intercept)" = "Intercept",
"internet_1"  = "Internet Hours/Day",
"age"         = "Age",
"lgbtqLGBTQ+" = "LGBTQ+ (ref: Cis-Hetero)",
"first_genFirst-Gen" = "First-Gen (ref: Not First-Gen)",
"belong1"     = "Sense of Belonging",
"fincur_stress" = "Current Financial Stress",
"deprawsc"    = "Depression Score (PHQ-9)"),
across(where(is.numeric), ~round(.x, 3))
) %>%
rename(Term = term, `β` = estimate, SE = std.error,
`t` = statistic, `p-value` = p.value,
`95% CI Low` = conf.low, `95% CI High` = conf.high) %>%
kable(booktabs = TRUE,
caption = "Adjusted linear regression of GAD-7 anxiety score (N = 34,953).") %>%
kable_styling(latex_options = c("striped", "hold_position"),
font_size = 9) %>%
row_spec(0, bold = TRUE) # Makes the header row bold
coefs <- tidy(model_adj, conf.int = TRUE)
b_internet <- round(filter(coefs, term == "internet_1")$estimate, 3)
ci_low     <- round(filter(coefs, term == "internet_1")$conf.low, 3)
ci_high    <- round(filter(coefs, term == "internet_1")$conf.high, 3)
p_internet <- filter(coefs, term == "internet_1")$p.value
p_str      <- ifelse(p_internet < 0.001, "< 0.001", paste0("= ", round(p_internet, 3)))
r2_adj     <- round(summary(model_adj)$adj.r.squared, 3)
model_lgbtq <- lm(anx_score ~ internet_1 * lgbtq + age + first_gen +
belong1 + fincur_stress + deprawsc, data = model_df)
model_fg    <- lm(anx_score ~ internet_1 * first_gen + age + lgbtq +
belong1 + fincur_stress + deprawsc, data = model_df)
# Extract interaction terms only
int_lgbtq <- tidy(model_lgbtq, conf.int = TRUE) %>%
filter(str_detect(term, ":")) %>%
mutate(Model = "internet_1 × LGBTQ+")
int_fg <- tidy(model_fg, conf.int = TRUE) %>%
filter(str_detect(term, ":")) %>%
mutate(Model = "internet_1 × First-Gen")
bind_rows(int_lgbtq, int_fg) %>%
mutate(across(where(is.numeric), ~round(.x, 3))) %>%
select(Model, `β` = estimate, SE = std.error,
`t` = statistic, `p-value` = p.value,
`95% CI Low` = conf.low, `95% CI High` = conf.high) %>%
kable(caption = "Interaction (moderation) terms from Models 3a and 3b, testing whether the internet–anxiety association differs by LGBTQ+ identity or first-generation status.")
# Predicted values for interaction plots
newdat_lgbtq <- expand.grid(
internet_1   = seq(0, 16, by = 0.5),
lgbtq        = levels(model_df$lgbtq),
age          = mean(model_df$age, na.rm = TRUE),
first_gen    = "Not First-Gen",
belong1      = mean(model_df$belong1, na.rm = TRUE),
fincur_stress = mean(model_df$fincur_stress, na.rm = TRUE),
deprawsc     = mean(model_df$deprawsc, na.rm = TRUE)
) %>%
bind_cols(as.data.frame(predict(model_lgbtq, newdata = .,
interval = "confidence"))) %>%
rename(predicted = fit)
newdat_fg <- expand.grid(
internet_1   = seq(0, 16, by = 0.5),
first_gen    = levels(model_df$first_gen),
age          = mean(model_df$age, na.rm = TRUE),
lgbtq        = "Cis-Hetero",
belong1      = mean(model_df$belong1, na.rm = TRUE),
fincur_stress = mean(model_df$fincur_stress, na.rm = TRUE),
deprawsc     = mean(model_df$deprawsc, na.rm = TRUE)
) %>%
bind_cols(as.data.frame(predict(model_fg, newdata = .,
interval = "confidence"))) %>%
rename(predicted = fit)
