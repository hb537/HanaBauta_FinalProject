library(tidyverse)
library(ggpubr)
library(knitr)
library(broom)
library(kableExtra)
options(knitr.table.format = "latex")
hms <- read_csv("/Users/hanabauta/Desktop/HanaBauta_FinalProject/Data/HMS Data/hms_subset.csv")
# Cleaning dataset & subgrouping
analysis_df <- hms %>%
filter(!is.na(internet_1), !is.na(anx_score)) %>%
mutate(
lgbtq     = factor(lgbtq,     labels = c("Cis-Hetero", "LGBTQ+")),
first_gen = factor(first_gen, labels = c("Not First-Gen", "First-Gen"))
)
model_df <- analysis_df %>%
filter(!is.na(age), !is.na(belong1), !is.na(fincur_stress),
!is.na(lgbtq), !is.na(first_gen), !is.na(deprawsc))
#variables for table
desc_tbl <- analysis_df %>%
summarise(
`N` = as.character(n()),
`Mean Age (SD)` = paste0(round(mean(age, na.rm = TRUE), 1),
" (", round(sd(age, na.rm = TRUE), 1), ")"),
`Mean Anxiety Score (SD)` = paste0(round(mean(anx_score, na.rm = TRUE), 2),
" (", round(sd(anx_score, na.rm = TRUE), 2), ")"),
`Mean Internet Hrs/Day (SD)` = paste0(round(mean(internet_1, na.rm = TRUE), 2),
" (", round(sd(internet_1, na.rm = TRUE), 2), ")"),
`LGBTQ+ (%)` = paste0(round(mean(lgbtq == "LGBTQ+", na.rm = TRUE) * 100, 1), "%"),
`First-Gen (%)` = paste0(round(mean(first_gen == "First-Gen", na.rm = TRUE) * 100, 1), "%")
) %>%
pivot_longer(everything(), names_to = "Characteristic", values_to = "Value")
#table
kable(desc_tbl,
booktabs = TRUE,
caption = "Descriptive statistics for the primary analysis sample.") %>%
kable_styling(latex_options = c("striped", "hold_position"),
full_width = FALSE,
position = "center") %>%
row_spec(0, bold = TRUE, color = "white", background = "#800020") %>%  # Burgundy header
column_spec(1, bold = TRUE, border_right = TRUE) %>%
column_spec(2, width = "5cm") %>%
row_spec(1:nrow(desc_tbl), background = "#FAF5F6")
mean_anx <- mean(analysis_df$anx_score, na.rm = TRUE)
mean_int <- mean(analysis_df$internet_1, na.rm = TRUE)
p1 <- ggplot(analysis_df, aes(x = anx_score)) +
geom_histogram(binwidth = 1, fill = "#4E79A7", color = "white", linewidth = 0.3) +
geom_vline(xintercept = mean_anx, linetype = "dashed",
color = "#222", linewidth = 0.6) +
annotate("text", x = mean_anx + 1.2, y = Inf,
label = paste0("Mean = ", round(mean_anx, 1)),
vjust = 2, hjust = 0, size = 3, color = "#444") +
scale_x_continuous(breaks = seq(0, 21, by = 3)) +
scale_y_continuous(labels = scales::comma) +
labs(x = "GAD-7 Anxiety Score", y = "Number of Students",
title = "A. Anxiety Severity") +
theme_minimal(base_size = 11) +
theme(
plot.title      = element_text(face = "bold", size = 10, color = "#222"),
axis.title      = element_text(size = 9, color = "#444"),
axis.text       = element_text(size = 8.5, color = "#555"),
panel.grid.minor = element_blank(),
panel.grid.major = element_line(color = "#EEEEEE"),
plot.margin     = margin(6, 10, 6, 6)
)
p2 <- ggplot(analysis_df, aes(x = internet_1)) +
geom_histogram(binwidth = 1, fill = "#E15759", color = "white", linewidth = 0.3) +
geom_vline(xintercept = mean_int, linetype = "dashed",
color = "#222", linewidth = 0.6) +
annotate("text", x = mean_int + 0.4, y = Inf,
label = paste0("Mean = ", round(mean_int, 1), " hrs"),
vjust = 2, hjust = 0, size = 3, color = "#444") +
scale_x_continuous(breaks = seq(0, 20, by = 4)) +
scale_y_continuous(labels = scales::comma) +
labs(x = "Daily Internet Hours", y = "Number of Students",
title = "B. Daily Internet Use") +
theme_minimal(base_size = 11) +
theme(
plot.title      = element_text(face = "bold", size = 10, color = "#222"),
axis.title      = element_text(size = 9, color = "#444"),
axis.text       = element_text(size = 8.5, color = "#555"),
panel.grid.minor = element_blank(),
panel.grid.major = element_line(color = "#EEEEEE"),
plot.margin     = margin(6, 6, 6, 10)
)
ggarrange(p1, p2, ncol = 2)
overall_mean <- mean(analysis_df$anx_score, na.rm = TRUE)
group_summary <- analysis_df %>%
pivot_longer(cols = c(lgbtq, first_gen), names_to = "group_var", values_to = "group") %>%
filter(!is.na(group)) %>%
group_by(group_var, group) %>%
summarise(
mean_anx = mean(anx_score, na.rm = TRUE),
se       = sd(anx_score, na.rm = TRUE) / sqrt(n()),
n        = n(),
.groups  = "drop"
) %>%
mutate(
group_var = recode(group_var,
"lgbtq"     = "LGBTQ+ Identity",
"first_gen" = "First-Generation Status"),
ci_low  = mean_anx - 1.96 * se,
ci_high = mean_anx + 1.96 * se,
n_label = paste0("n = ", scales::comma(n))
)
ggplot(group_summary, aes(x = group, y = mean_anx, fill = group)) +
# Overall mean reference
geom_hline(yintercept = overall_mean, linetype = "dashed",
color = "#666", linewidth = 0.5) +
# Bars
geom_col(width = 0.48, alpha = 0.9) +
# Error bars
geom_errorbar(aes(ymin = ci_low, ymax = ci_high),
width = 0.14, linewidth = 0.65, color = "#333") +
# Sample size labels above bars
geom_text(aes(y = ci_high + 0.18, label = n_label),
size = 2.85, color = "#444", fontface = "plain") +
# Overall mean annotation (only on first panel)
geom_text(data = data.frame(group_var = "LGBTQ+ Identity",
group = NA, mean_anx = overall_mean),
aes(x = 0.55, y = overall_mean + 0.22,
label = paste0("Overall mean = ", round(overall_mean, 1))),
inherit.aes = FALSE, hjust = 0, size = 2.7, color = "#666",
fontface = "italic") +
facet_wrap(~group_var, scales = "free_x") +
scale_fill_manual(values = c(
"Cis-Hetero"    = "#4E79A7",
"LGBTQ+"        = "#E15759",
"Not First-Gen" = "#4E79A7",
"First-Gen"     = "#E15759"
)) +
scale_y_continuous(limits = c(0, NA), expand = expansion(mult = c(0, 0.12))) +
labs(x = NULL, y = "Mean GAD-7 Score (0-21)") +
theme_minimal(base_size = 11) +
theme(
legend.position  = "none",
strip.text       = element_text(face = "bold", size = 10, color = "#222"),
axis.title.y     = element_text(size = 9, color = "#444"),
axis.text.x      = element_text(size = 9.5, color = "#222"),
axis.text.y      = element_text(size = 8.5, color = "#555"),
panel.grid.major.x = element_blank(),
panel.grid.minor   = element_blank(),
panel.grid.major.y = element_line(color = "#EEEEEE"),
panel.spacing      = unit(1.4, "lines"),
plot.margin        = margin(6, 10, 6, 6)
)
