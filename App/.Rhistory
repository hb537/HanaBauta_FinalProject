cat("Subset dimensions:", nrow(hms_subset), "rows x", ncol(hms_subset), "cols\n")
# -----------------------------------------------------------------------------
# STEP 3: Create derived variables
# -----------------------------------------------------------------------------
hms_subset <- hms_subset %>%
mutate(
# Tech engagement as numeric (for regression)
tech_engagement_level = as.numeric(internet_1),
# LGBTQ+ indicator: 1 if any non-heterosexual identity selected
lgbtq = as.integer(
rowSums(
select(., sexual_l, sexual_g, sexual_bi, sexual_queer,
sexual_quest, sexual_asexual, sexual_pan),
na.rm = TRUE
) > 0
),
# First-generation college student proxy:
# 1 if BOTH parents have no bachelor's degree (educ_par codes 1–3 = HS or less)
first_gen = case_when(
educ_par1 <= 3 & educ_par2 <= 3 ~ 1L,
educ_par1 >  3 | educ_par2 >  3 ~ 0L,
TRUE ~ NA_integer_
),
# Financial stress reversed: higher score = MORE stressed (easier to interpret)
# Original: 1=Always stressful → 5=Never stressful
fincur_stress  = 6L - as.integer(fincur),
finpast_stress = 6L - as.integer(finpast),
# Sleep on weeknights recoded to approximate midpoint hours
sleep_hrs = case_when(
sleep_wknight == 1 ~ 0.5,
sleep_wknight == 2 ~ 2.5,
sleep_wknight == 3 ~ 4.5,
sleep_wknight == 4 ~ 6.0,
sleep_wknight == 5 ~ 7.0,
sleep_wknight == 6 ~ 8.0,
sleep_wknight == 7 ~ 9.0,
sleep_wknight == 8 ~ 10.5,
TRUE ~ NA_real_
),
# Adequate sleep flag: 1 if ≥ 7 hrs on weeknights (CDC recommendation)
adequate_sleep = as.integer(sleep_hrs >= 7),
# Brief Resilience Scale composite (mean of 6 items; items 2,4,6 are reverse-scored)
BRS_2r = 6 - BRS_2,
BRS_4r = 6 - BRS_4,
BRS_6r = 6 - BRS_6,
resilience_score = rowMeans(
cbind(BRS_1, BRS_2r, BRS_3, BRS_4r, BRS_5, BRS_6r),
na.rm = FALSE   # set TRUE if you want partial scores
),
# Self-compassion composite (mean of 6 items)
selfcompass_score = rowMeans(
select(., selfcompass_1:selfcompass_6),
na.rm = FALSE
),
# Any online negative experience
online_neg_any = as.integer(
rowSums(
select(., internet_2_1, internet_2_2, internet_2_3,
internet_2_4, internet_2_8, internet_2_11, internet_2_14),
na.rm = TRUE
) > 0
),
# Anxiety severity category (labeled factor — useful for tables/plots)
anx_severity_cat = case_when(
anx_score < 5  ~ "Minimal (0–4)",
anx_score < 10 ~ "Mild (5–9)",
anx_score < 15 ~ "Moderate (10–14)",
anx_score <= 21 ~ "Severe (15–21)",
TRUE ~ NA_character_
) %>% factor(levels = c("Minimal (0–4)", "Mild (5–9)",
"Moderate (10–14)", "Severe (15–21)")),
# Usage category label (matches checkpoint 6)
usage_cat = factor(internet_1,
levels = 1:8,
labels = c("None", "<1hr", "1-2hr", "2-3hr",
"3-4hr", "4-6hr", "6-9hr", "10+hr")
)
)
# -----------------------------------------------------------------------------
# STEP 4: Missing data summary for key analysis variables
# -----------------------------------------------------------------------------
cat("\n=== Missing data (%) for key variables ===\n")
key_vars <- c("internet_1", "anx_score", "deprawsc", "flourish",
"lonesc", "sleep_wknight", "fincur", "belong1",
"persist", "age", "gender_female", "lgbtq",
"resilience_score", "selfcompass_score")
hms_subset %>%
select(all_of(key_vars)) %>%
summarise(across(everything(),
~ paste0(round(mean(is.na(.)) * 100, 1), "%"))) %>%
pivot_longer(everything(),
names_to  = "Variable",
values_to = "Pct_Missing") %>%
print(n = Inf)
primary_analysis <- hms_subset %>%
filter(
!is.na(internet_1),
!is.na(anx_score),
!is.na(age),
!is.na(gender_female)
)
cat("\nN with complete cases on internet_1 + anx_score + age + gender:",
nrow(primary_analysis), "\n")
write_csv(hms_subset, "data/hms_final_subset.csv")
if (!dir.exists("data")) {
dir.create("data")
}
write_csv(hms_subset, "data/hms_final_subset.csv")
cat("\nN with complete cases on internet_1 + anx_score + age + gender:",
nrow(primary_analysis), "\n")
write_csv(hms_subset, "data/hms_final_subset.csv")
cat("\nSaved: data/hms_final_subset.csv\n")
