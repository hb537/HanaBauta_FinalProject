hms_subset <- hms_full %>%
select(
# --- Metadata ---
responseid,
schoolnum,
nrweight,          # non-response survey weight — use in all weighted models
# --- Core demographics ---
age,
sex_birth,         # 1=Female, 2=Male, 3=Intersex
# --- Gender identity (binary indicators) ---
gender_male,
gender_female,
gender_nonbin,     # gender non-binary
gender_queer,      # genderqueer / gender non-conforming
gender_trans,      # transgender
# --- Sexual orientation (binary indicators) ---
sexual_h,          # heterosexual
sexual_l,          # lesbian
sexual_g,          # gay
sexual_bi,         # bisexual
sexual_queer,      # queer
sexual_quest,      # questioning
sexual_asexual,    # asexual
sexual_pan,        # pansexual
# --- Race / ethnicity (binary indicators) ---
race_black,
race_white,
race_asian,
race_his,          # Hispanic / Latine
race_ainaan,       # American Indian or Alaskan Native
race_pi,           # Native Hawaiian or Pacific Islander
race_mides,        # Middle Eastern / Arab / Arab American
race_other,
# --- Socioeconomic status ---
fincur,            # current financial stress  (1=Always → 5=Never stressful)
finpast,           # past financial stress     (1=Always → 5=Never stressful)
food_worry,        # food insecurity           (1=Often true, 2=Sometimes, 3=Never)
pellgrant,         # Pell grant recipient (proxy for low-income)
educ_par1,         # parent 1 education level  (first-gen proxy)
educ_par2,         # parent 2 education level
# --- Academic / campus experience ---
belong1,           # sense of belonging to campus
persist,           # academic persistence confidence
yr_sch,            # year in school (1=1st yr → 5=5th+ yr)
enroll,            # full-time vs part-time    (1=Full-time, 2=Part-time)
housing_worry,     # housing insecurity worry
# --- Discrimination experiences ---
discrim_race,      # experienced discrimination based on race
discrim_gender,    # experienced discrimination based on gender
discrim_sexual,    # experienced discrimination based on sexual orientation
discrim_culture,   # experienced discrimination based on culture/religion
discrim_other,
# --- Technology use — EXPOSURE variable ---
internet_1,        # daily internet/social media use (1=None → 8=10+ hrs/day)
internet_2_1,      # negative online experience: saw something upsetting
internet_2_2,      # negative online experience: cyberbullied
internet_2_3,      # negative online experience: unwanted sexual contact
internet_2_4,      # negative online experience: threatened/harassed
internet_2_8,      # negative online experience: group harassment
internet_2_11,     # negative online experience: impersonation
internet_2_14,     # negative online experience: swatting
# --- Anxiety — PRIMARY OUTCOME ---
gad7_1, gad7_2, gad7_3, gad7_4,   # individual GAD-7 items (0–3 each)
gad7_5, gad7_6, gad7_7,
anx_score,         # GAD-7 total score (0–21); composite created during cleaning
anx_any,           # anxiety positive case: score ≥ 10
anx_mod,           # moderate anxiety: score 10–14
anx_sev,           # severe anxiety:   score ≥ 15
# --- Depression — SECONDARY OUTCOME ---
phq9_1, phq9_2, phq9_3, phq9_4,   # individual PHQ-9 items (0–3 each)
phq9_5, phq9_6, phq9_7, phq9_8, phq9_9,
deprawsc,          # PHQ-9 total score (0–27); composite created during cleaning
dep_any,           # depression positive case: score ≥ 10
dep_maj,           # major depression:  score ≥ 15
dep_oth,           # other depression:  score 10–14
dep_impa,          # depression functional impairment item
dep_or_anx,        # either depression or anxiety positive
# --- Positive mental health / flourishing ---
diener1, diener2, diener3, diener4,  # Diener Flourishing Scale items (1–7 each)
diener5, diener6, diener7, diener8,
flourish,          # Diener total score (8–56); higher = greater flourishing
positiveMH,        # positive MH case: flourish > 48
# --- Loneliness (UCLA 3-item scale) ---
lone_lackcompanion,   # item 1: lack companionship
lone_leftout,         # item 2: feel left out
lone_isolated,        # item 3: feel isolated
lonesc,               # UCLA total score (3–9); NOTE: variable is "lonesc" in this dataset
lonely,               # loneliness positive case: lonsc > 6
# --- Sleep ---
sleep_wknight,     # avg sleep on weeknights (ordinal: 1=<1hr → 8=10+hrs)
sleep_wkend,       # avg sleep on weekends   (ordinal: 1=<1hr → 8=10+hrs)
# --- Physical health / exercise ---
exerc,             # days per week of moderate/vigorous exercise
# --- Any mental health problem flag ---
anymhprob,         # positive on dep_any OR anx_any OR other MH screening
# --- Prior mental health diagnosis (self-reported) ---
dx_dep,            # ever diagnosed: depression
dx_anx,            # ever diagnosed: anxiety
dx_none,           # no prior MH diagnosis
# --- Resilience (Brief Resilience Scale) ---
BRS_1, BRS_2, BRS_3, BRS_4, BRS_5, BRS_6,
# --- Self-compassion ---
selfcompass_1, selfcompass_2, selfcompass_3,
selfcompass_4, selfcompass_5, selfcompass_6
)
