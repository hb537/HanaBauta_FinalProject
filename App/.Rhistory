library(tidyverse)
library(ggpubr)
library(knitr)
library(broom)
hms <- read_csv("../Data/HMS Data/hms_subset.csv")
# Data cleaning: Filter for primary RQs and handle factors
analysis_df <- hms %>%
filter(!is.na(internet_1), !is.na(anx_score)) %>%
mutate(
lgbtq = factor(lgbtq, labels = c("Cis-Hetero", "LGBTQ+")),
first_gen = factor(first_gen, labels = c("Not First-Gen", "First-Gen"))
)
# Table summary
analysis_df %>%
summarise(
N = n(),
`Mean Anxiety (SD)` = paste0(round(mean(anx_score, na.rm=T), 2), " (", round(sd(anx_score, na.rm=T), 2), ")"),
`Mean Internet Hrs (SD)` = paste0(round(mean(internet_1, na.rm=T), 2), " (", round(sd(internet_1, na.rm=T), 2), ")")
) %>%
kable(caption = "Summary Statistics for Primary Analysis Sample")
ggplot(analysis_df, aes(x = internet_1, y = anx_score, color = lgbtq)) +
geom_jitter(alpha = 0.1) +
geom_smooth(method = "lm") +
labs(x = "Daily Internet Hours", y = "Anxiety Score (GAD-7)", color = "Identity") +
theme_minimal()
# Multivariable Model
model_adj <- lm(anx_score ~ internet_1 + age + lgbtq + first_gen + belong1 + fincur_stress, data = analysis_df)
model_results <- tidy(model_adj, conf.int = TRUE)
kable(model_results, digits = 3, caption = "Adjusted Regression Results for Anxiety Symptom Severity")
runApp()
shiny::runApp()
runApp()
runApp()
shiny::runApp()
