# Cleaning dataset:
analysis_df <- hms %>%
filter(!is.na(internet_1), !is.na(anx_score)) %>%
mutate(
lgbtq     = factor(lgbtq,     labels = c("Cis-Hetero", "LGBTQ+")),
first_gen = factor(first_gen, labels = c("Not First-Gen", "First-Gen"))
)
# Complete-case dataset for multivariable model
model_df <- analysis_df %>%
filter(!is.na(age), !is.na(belong1), !is.na(fincur_stress),
!is.na(lgbtq), !is.na(first_gen), !is.na(deprawsc))
View(model_df)
desc_tbl <- analysis_df %>%
summarise(
`N` = as.character(n()),
`Mean Age (SD)` = paste0(round(mean(age, na.rm = TRUE), 1),
" (", round(sd(age, na.rm = TRUE), 1), ")"),
`Mean Anxiety Score (SD)` = paste0(round(mean(anx_score, na.rm = TRUE), 2),
" (", round(sd(anx_score, na.rm = TRUE), 2), ")"),
`Mean Internet Hrs/Day (SD)` = paste0(round(mean(internet_1, na.rm = TRUE), 2),
" (", round(sd(internet_1, na.rm = TRUE), 2), ")"),
`LGBTQ+ (%)` = paste0(round(mean(lgbtq == "LGBTQ+", na.rm = TRUE) * 100, 1), "%"),
`First-Gen (%)` = paste0(round(mean(first_gen == "First-Gen", na.rm = TRUE) * 100, 1), "%")
) %>%
pivot_longer(everything(), names_to = "Characteristic", values_to = "Value")
kable(desc_tbl,
caption = "Descriptive statistics for the primary analysis sample (N = 34,953). Continuous variables are reported as mean (SD).")
# Data cleaning: Filter for primary RQs and handle factors
analysis_df <- hms %>%
filter(!is.na(internet_1), !is.na(anx_score)) %>%
mutate(
lgbtq = factor(lgbtq, labels = c("Cis-Hetero", "LGBTQ+")),
first_gen = factor(first_gen, labels = c("Not First-Gen", "First-Gen"))
)
# Table summary
analysis_df %>%
summarise(
N = n(),
`Mean Anxiety (SD)` = paste0(round(mean(anx_score, na.rm=T), 2), " (", round(sd(anx_score, na.rm=T), 2), ")"),
`Mean Internet Hrs (SD)` = paste0(round(mean(internet_1, na.rm=T), 2), " (", round(sd(internet_1, na.rm=T), 2), ")")
) %>%
kable(caption = "Summary Statistics for Primary Analysis Sample")
