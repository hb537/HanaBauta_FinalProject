library(tidyverse)
library(ggpubr)
library(knitr)
library(broom)
hms <- read_csv("/Users/hanabauta/Desktop/HanaBauta_FinalProject/Data/HMS Data/hms_subset.csv")
# Primary analysis dataset: non-missing on exposure & outcome
analysis_df <- hms %>%
filter(!is.na(internet_1), !is.na(anx_score)) %>%
mutate(
lgbtq     = factor(lgbtq,     labels = c("Cis-Hetero", "LGBTQ+")),
first_gen = factor(first_gen, labels = c("Not First-Gen", "First-Gen"))
)
# Complete-case dataset for multivariable model
model_df <- analysis_df %>%
filter(!is.na(age), !is.na(belong1), !is.na(fincur_stress),
!is.na(lgbtq), !is.na(first_gen), !is.na(deprawsc))
desc_tbl <- analysis_df %>%
summarise(
`N` = as.character(n()),
`Mean Age (SD)` = paste0(round(mean(age, na.rm = TRUE), 1),
" (", round(sd(age, na.rm = TRUE), 1), ")"),
`Mean Anxiety Score (SD)` = paste0(round(mean(anx_score, na.rm = TRUE), 2),
" (", round(sd(anx_score, na.rm = TRUE), 2), ")"),
`Mean Internet Hrs/Day (SD)` = paste0(round(mean(internet_1, na.rm = TRUE), 2),
" (", round(sd(internet_1, na.rm = TRUE), 2), ")"),
`LGBTQ+ (%)` = paste0(round(mean(lgbtq == "LGBTQ+", na.rm = TRUE) * 100, 1), "%"),
`First-Gen (%)` = paste0(round(mean(first_gen == "First-Gen", na.rm = TRUE) * 100, 1), "%")
) %>%
pivot_longer(everything(), names_to = "Characteristic", values_to = "Value")
kable(desc_tbl,
caption = "Descriptive statistics for the primary analysis sample (N = 34,953). Continuous variables are reported as mean (SD).")
p1 <- ggplot(analysis_df, aes(x = anx_score)) +
geom_histogram(binwidth = 1, fill = "#4E9AF1", color = "white") +
labs(x = "GAD-7 Anxiety Score", y = "Count") +
theme_minimal(base_size = 11)
p2 <- ggplot(analysis_df, aes(x = internet_1)) +
geom_histogram(binwidth = 1, fill = "#F4845F", color = "white") +
labs(x = "Daily Internet Hours", y = "Count") +
theme_minimal(base_size = 11)
ggarrange(p1, p2, ncol = 2)
group_summary <- analysis_df %>%
pivot_longer(cols = c(lgbtq, first_gen), names_to = "group_var", values_to = "group") %>%
filter(!is.na(group)) %>%
group_by(group_var, group) %>%
summarise(
mean_anx = mean(anx_score, na.rm = TRUE),
se = sd(anx_score, na.rm = TRUE) / sqrt(n()),
.groups = "drop"
) %>%
mutate(group_var = recode(group_var,
"lgbtq" = "LGBTQ+ Identity",
"first_gen" = "First-Gen Status"))
ggplot(group_summary, aes(x = group, y = mean_anx, fill = group)) +
geom_col(width = 0.5) +
geom_errorbar(aes(ymin = mean_anx - 1.96 * se, ymax = mean_anx + 1.96 * se),
width = 0.2) +
facet_wrap(~group_var, scales = "free_x") +
scale_fill_manual(values = c("#4E9AF1", "#F4845F", "#6BCB77", "#FFD166")) +
labs(x = NULL, y = "Mean GAD-7 Score", fill = NULL) +
theme_minimal(base_size = 11) +
theme(legend.position = "none")
model_adj <- lm(anx_score ~ internet_1 + age + lgbtq + first_gen +
belong1 + fincur_stress + deprawsc, data = model_df)
aug <- augment(model_adj)
p_resfit <- ggplot(aug, aes(x = .fitted, y = .resid)) +
geom_point(alpha = 0.05, size = 0.8) +
geom_hline(yintercept = 0, color = "red", linetype = "dashed") +
geom_smooth(method = "loess", se = FALSE, color = "steelblue", linewidth = 0.8) +
labs(x = "Fitted Values", y = "Residuals", title = "Residuals vs. Fitted") +
theme_minimal(base_size = 11)
p_qq <- ggplot(aug, aes(sample = .std.resid)) +
stat_qq(alpha = 0.05, size = 0.8) +
stat_qq_line(color = "red") +
labs(x = "Theoretical Quantiles", y = "Standardized Residuals",
title = "Normal Q–Q Plot") +
theme_minimal(base_size = 11)
ggarrange(p_resfit, p_qq, ncol = 2)
ggplot(analysis_df %>% filter(!is.na(lgbtq)),
aes(x = internet_1, y = anx_score, color = lgbtq)) +
geom_jitter(alpha = 0.07, size = 0.7) +
geom_smooth(method = "lm", se = TRUE, linewidth = 1) +
scale_color_manual(values = c("Cis-Hetero" = "#4E9AF1", "LGBTQ+" = "#F4845F")) +
labs(x = "Daily Internet Hours", y = "GAD-7 Anxiety Score",
color = "Identity") +
theme_minimal(base_size = 11)
model_unaj <- lm(anx_score ~ internet_1, data = analysis_df)
tidy(model_unaj, conf.int = TRUE) %>%
mutate(across(where(is.numeric), ~round(.x, 3))) %>%
rename(Term = term, `β` = estimate, SE = std.error,
`t` = statistic, `p-value` = p.value,
`95% CI Low` = conf.low, `95% CI High` = conf.high) %>%
kable(caption = "Unadjusted linear regression of GAD-7 anxiety score on daily internet hours (N = 34,953).")
tidy(model_adj, conf.int = TRUE) %>%
mutate(
term = recode(term,
"(Intercept)" = "Intercept",
"internet_1"  = "Internet Hours/Day",
"age"         = "Age",
"lgbtqLGBTQ+" = "LGBTQ+ (ref: Cis-Hetero)",
"first_genFirst-Gen" = "First-Gen (ref: Not First-Gen)",
"belong1"     = "Sense of Belonging",
"fincur_stress" = "Current Financial Stress",
"deprawsc"    = "Depression Score (PHQ-9)"),
across(where(is.numeric), ~round(.x, 3))
) %>%
rename(Term = term, `β` = estimate, SE = std.error,
`t` = statistic, `p-value` = p.value,
`95% CI Low` = conf.low, `95% CI High` = conf.high) %>%
kable(caption = paste0("Adjusted linear regression of GAD-7 anxiety score on daily internet hours and covariates (N = ", nrow(model_df), "). β = unstandardized regression coefficient."))
coefs <- tidy(model_adj, conf.int = TRUE)
b_internet <- round(filter(coefs, term == "internet_1")$estimate, 3)
ci_low     <- round(filter(coefs, term == "internet_1")$conf.low, 3)
ci_high    <- round(filter(coefs, term == "internet_1")$conf.high, 3)
p_internet <- filter(coefs, term == "internet_1")$p.value
p_str      <- ifelse(p_internet < 0.001, "< 0.001", paste0("= ", round(p_internet, 3)))
r2_adj     <- round(summary(model_adj)$adj.r.squared, 3)
model_lgbtq <- lm(anx_score ~ internet_1 * lgbtq + age + first_gen +
belong1 + fincur_stress + deprawsc, data = model_df)
model_fg    <- lm(anx_score ~ internet_1 * first_gen + age + lgbtq +
belong1 + fincur_stress + deprawsc, data = model_df)
# Extract interaction terms only
int_lgbtq <- tidy(model_lgbtq, conf.int = TRUE) %>%
filter(str_detect(term, ":")) %>%
mutate(Model = "internet_1 × LGBTQ+")
int_fg <- tidy(model_fg, conf.int = TRUE) %>%
filter(str_detect(term, ":")) %>%
mutate(Model = "internet_1 × First-Gen")
bind_rows(int_lgbtq, int_fg) %>%
mutate(across(where(is.numeric), ~round(.x, 3))) %>%
select(Model, `β` = estimate, SE = std.error,
`t` = statistic, `p-value` = p.value,
`95% CI Low` = conf.low, `95% CI High` = conf.high) %>%
kable(caption = "Interaction (moderation) terms from Models 3a and 3b, testing whether the internet–anxiety association differs by LGBTQ+ identity or first-generation status.")
# Predicted values for interaction plots
newdat_lgbtq <- expand.grid(
internet_1   = seq(0, 16, by = 0.5),
lgbtq        = levels(model_df$lgbtq),
age          = mean(model_df$age, na.rm = TRUE),
first_gen    = "Not First-Gen",
belong1      = mean(model_df$belong1, na.rm = TRUE),
fincur_stress = mean(model_df$fincur_stress, na.rm = TRUE),
deprawsc     = mean(model_df$deprawsc, na.rm = TRUE)
) %>%
bind_cols(as.data.frame(predict(model_lgbtq, newdata = .,
interval = "confidence"))) %>%
rename(predicted = fit)
newdat_fg <- expand.grid(
internet_1   = seq(0, 16, by = 0.5),
first_gen    = levels(model_df$first_gen),
age          = mean(model_df$age, na.rm = TRUE),
lgbtq        = "Cis-Hetero",
belong1      = mean(model_df$belong1, na.rm = TRUE),
fincur_stress = mean(model_df$fincur_stress, na.rm = TRUE),
deprawsc     = mean(model_df$deprawsc, na.rm = TRUE)
) %>%
bind_cols(as.data.frame(predict(model_fg, newdata = .,
interval = "confidence"))) %>%
rename(predicted = fit)
p_mod1 <- ggplot(newdat_lgbtq, aes(x = internet_1, y = predicted, color = lgbtq, fill = lgbtq)) +
geom_ribbon(aes(ymin = lwr, ymax = upr), alpha = 0.15, color = NA) +
geom_line(linewidth = 1) +
scale_color_manual(values = c("Cis-Hetero" = "#4E9AF1", "LGBTQ+" = "#F4845F")) +
scale_fill_manual(values  = c("Cis-Hetero" = "#4E9AF1", "LGBTQ+" = "#F4845F")) +
labs(x = "Internet Hours/Day", y = "Predicted GAD-7", color = "Identity", fill = "Identity",
title = "By LGBTQ+ Identity") +
theme_minimal(base_size = 10)
p_mod2 <- ggplot(newdat_fg, aes(x = internet_1, y = predicted, color = first_gen, fill = first_gen)) +
geom_ribbon(aes(ymin = lwr, ymax = upr), alpha = 0.15, color = NA) +
geom_line(linewidth = 1) +
scale_color_manual(values = c("Not First-Gen" = "#6BCB77", "First-Gen" = "#FFD166")) +
scale_fill_manual(values  = c("Not First-Gen" = "#6BCB77", "First-Gen" = "#FFD166")) +
labs(x = "Internet Hours/Day", y = "Predicted GAD-7", color = "Status", fill = "Status",
title = "By First-Gen Status") +
theme_minimal(base_size = 10)
ggarrange(p_mod1, p_mod2, ncol = 2)
